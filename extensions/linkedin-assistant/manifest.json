{
  "manifest_version": 3,
  "name": "MCN LinkedIn Assistant",
  "version": "0.1.0",
  "description": "Shows the ready-made MCN Outreach message for the LinkedIn profile you have open. You read it, insert it and press Send yourself.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "activeTab", "sidePanel"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "MCN LinkedIn Assistant",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
